{
  "name": "react-native-attachment-kit",
  "version": "1.0.11",
  "description": "Native attachment kit for React Native — gallery picker, editor, image viewer and media gallery (Turbo Module)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "example": "yarn --cwd ../RNAttachmentKitApp"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "attachment",
    "image-picker",
    "gallery",
    "photo-picker",
    "media-gallery",
    "image-viewer",
    "image-editor",
    "turbo-module",
    "new-architecture"
  ],
  "homepage": "https://github.com/Usomnia/react-native-attachment-kit",
  "author": "Mike",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "src",
    "ios/RNAttachmentKit.xcframework",
    "ios/RNAttachmentKit.m",
    "ios/RNAttachmentKit.swift",
    "ios/RNAttachmentKitAssets",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/proguard-rules.pro",
    "react-native-attachment-kit.podspec",
    "README.md",
    "CHANGELOG.md",
    "react-native.config.js"
  ],
  "codegenConfig": {
    "name": "RNAttachmentKitSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnattachmentkit"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Usomnia/react-native-attachment-kit.git"
  }
}